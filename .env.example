# Один из ключей нужен только для автоматического создания lesson draft.
# Оставьте ненужный провайдер пустым. Реальные значения храните в окружении или .env,
# никогда не коммитьте их.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Опционально: абсолютный путь к папке внешних тем вида <theme-id>/theme.json.
THEMES_EXT=
