{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automontage.local/schema/source-edit.schema.json",
  "title": "AutoMontage Source Edit",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceRevision", "fps", "keep"],
  "properties": {
    "version": {"const": 1},
    "sourceRevision": {"type": "integer", "minimum": 1},
    "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 240},
    "keep": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
